{
  "manifest_version": 3,
  "name": "HAPPY JS",
  "version": "1.0.9",
  "description": "跨浏览器敏感信息与指纹扫描 · 动态/深度扫描 · JS逆向Hook辅助 · 反蜜罐与特征对抗",
  "author": "HappyJS",

  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "webRequest",
    "webNavigation",
    "cookies",
    "contextMenus",
    "declarativeNetRequest",
    "browsingData",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "HAPPY JS",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "inject/*.js",
        "hooks/*.js",
        "icons/*.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "happyjs@local.extension",
      "strict_min_version": "115.0"
    }
  }
}
